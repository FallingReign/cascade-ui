    {
      "name": "app-shell",
      "type": "registry:ui",
      "title": "App Shell",
      "description": "The outer layout frame for Cascade and its consumers. Wires together a collapsible sidebar region, a top toolbar/perspective-switcher slot, a main content area, and an optional status-bar footer. All regions accept ReactNode — the shell ships structure only.",
      "registryDependencies": [
        "sidebar",
        "separator",
        "button",
        "FallingReign/cascade-ui/cascade-theme"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "registry/ui/app-shell.tsx",
          "type": "registry:ui",
          "target": "components/ui/app-shell.tsx"
        }
      ]
    },
    {
      "name": "perspective-switcher",
      "type": "registry:ui",
      "title": "Perspective Switcher",
      "description": "An animated icon bar where the active perspective expands to a labelled pill. Direction-aware, keyboard accessible, reduced-motion aware. Adapted from beUI expandable-tabs (MIT). Uses motion/react. Slots into AppShell's toolbar slot.",
      "registryDependencies": [
        "FallingReign/cascade-ui/cascade-theme"
