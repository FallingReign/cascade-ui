    {
      "name": "file-tree",
      "type": "registry:ui",
      "title": "File Tree",
      "description": "A recursive, collapsible file-system navigator for IDE-like interfaces. Built on shadcn ScrollArea and Collapsible primitives.",
      "registryDependencies": ["scroll-area", "collapsible"],
      "dependencies": ["lucide-react"],
      "files": [
